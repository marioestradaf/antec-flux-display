[Unit]
Description=Antec Flux Pro Display Temperature Service
After=systemd-udevd.service
Wants=systemd-udevd.service

StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple

User=antec-flux
Group=antec-flux

ExecStart=/usr/bin/python3 /usr/local/libexec/antec-flux-display/antec-flux-display.py

Restart=on-failure
RestartSec=5
TimeoutStopSec=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

# The process must see /dev/bus/usb.
PrivateDevices=no

[Install]
WantedBy=multi-user.target
